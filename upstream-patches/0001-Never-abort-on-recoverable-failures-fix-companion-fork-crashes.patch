+// Clear any pending exception left by a failed JNI lookup. Leaving an
+// exception pending inside system_server crashes the process later at an
+// unrelated JNI call site.
+static void clear_pending_exception(JNIEnv *env) {
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionClear(env);
+    }
+}
+
 int binder_interceptors_init(JNIEnv *env, jclass c_loader) {
     void (*set_jni_env)(struct JNINativeInterface *) = plt_dlsym(
             "_ZN3art9JNIEnvExt16SetTableOverrideEPK18JNINativeInterface", NULL);
